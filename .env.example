# These are provided automatically when you add a "Redis" (Upstash)
# integration to this project from the Vercel Marketplace — you do not need
# to fill them in by hand for a deployed app. The code accepts either naming
# convention Vercel has used for this integration.
#
# For local development, run `vercel env pull .env.local` after linking this
# folder to your Vercel project (`vercel link`) once the integration is
# added, and it will create a working .env.local for you automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
